# Where the SQLite database lives (relative to app working dir, or absolute)
DATABASE_PATH=data/stocks.db

# Path to the mining universe CSV
UNIVERSE_CSV=data/mining_stocks.csv

# Data is considered fresh for this many hours before a background refresh
FRESH_HOURS=6

# Web server port (Render injects PORT automatically)
PORT=5000

# Set to "development" to enable the Flask debug server
FLASK_ENV=production